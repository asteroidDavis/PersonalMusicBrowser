DATABASE_URL=sqlite:music_browser.db
BIND_ADDR=127.0.0.1:3000
RUST_LOG=info

BACKUP_HOME="../"

# For local development, use HTTP. Switch to HTTPS in production with proper certs.
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_JWT_SECRET=change-me
# Only needed for HTTPS with self-signed certs (production or advanced local setup)
POCKETBASE_CA_CERT=
AUTH_COOKIE_SECURE=true
AUTH_ALLOW_EMPTY_JWT_SECRET=false
AUTH_REQUIRE_LOGIN=false
