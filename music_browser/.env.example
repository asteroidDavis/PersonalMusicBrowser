DATABASE_URL=sqlite:music_browser.db
BIND_ADDR=127.0.0.1:3000
RUST_LOG=info

BACKUP_HOME="../"

# For local development, use HTTP or HTTPS. Switch to HTTPS in production with proper certs.
POCKETBASE_URL=http://127.0.0.1:8090
# Only needed for HTTPS with self-signed certs (production or advanced local setup)
POCKETBASE_CA_CERT=
AUTH_COOKIE_SECURE=false
AUTH_REQUIRE_LOGIN=false
# /api/workflows stays public so the ARA plugin can enqueue jobs without credentials.
AUTH_PUBLIC_PATHS=/login,/signup,/logout,/api/workflows
# CSRF_SECRET for CSRF token validation (generate with: openssl rand -base64 32)
CSRF_SECRET=change-me-to-a-secure-random-32-byte-secret

# HTTPS Configuration (optional, for local development with self-signed certs)
# Set to true to enable HTTPS
# NOTE: Keep this false when testing with the ARA plugin (music_ara_client/).
# The plugin's HTTP client has no TLS/certificate-trust support yet, so an
# https:// hub URL fails with an opaque "failed to open POST stream" error.
# Tracked in https://github.com/asteroidDavis/PersonalMusicBrowser/issues/61.
HTTPS_ENABLED=false
# Path to SSL certificate file (PEM format)
SSL_CERT_PATH=./certs/server.crt
# Path to SSL private key file (PEM format)
SSL_KEY_PATH=./certs/server.key
# CSRF cookie secure flag (must be true when HTTPS_ENABLED=true)
CSRF_COOKIE_SECURE=false
